[Unit]
Description=Sonic AI V2 API
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/sonic-ai-v2/backend
ExecStart=/var/www/sonic-ai-v2/backend/.venv/bin/gunicorn -k uvicorn.workers.UvicornWorker app.main:app -b 127.0.0.1:8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
