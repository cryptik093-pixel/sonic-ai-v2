{
  "version": 2,
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.omega-house.online/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.omega-house.online/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
